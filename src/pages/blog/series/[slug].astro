---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { getNoteSeries, noteSeries } from '../../../content/noteSeries';
import { SITE_DESCRIPTION } from '../../../consts';

const posts = await getCollection('blog');

export function getStaticPaths() {
	return noteSeries.map((series) => ({
		params: { slug: series.slug },
		props: { series },
	}));
}

const { series } = Astro.props;
const seriesPosts = posts.filter((post) => getNoteSeries(post.id).slug === series.slug).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`${series.title} · Notes`} description={series.description || SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<a class="back-link" href={`${base}blog/`}>← 返回专栏目录</a>
			<section class="series-intro">
				<p class="eyebrow">Notes / Series</p>
				<h1>{series.title}</h1>
				<p class="lead">{series.description}</p>
			</section>
			<ul class="series-post-list">
				{seriesPosts.map((post) => (
					<li>
						<a href={`${base}blog/${post.id}/`}>
							<div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
							<FormattedDate date={post.data.pubDate} />
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.series-list, .series-post-list { display: grid; gap: 1rem; list-style: none; margin: 2rem 0 0; padding: 0; }
	.series-list li { border: 1px solid rgba(var(--black), 0.15); background: rgba(253, 251, 247, 0.7); }
	.series-list a { display: block; padding: 1.25rem; color: rgb(var(--black)); text-decoration: none; }
	.series-list a:hover h2 { color: var(--accent); }
	.series-list h2 { font-size: 1.5rem; }
	.series-list p { margin: 0 0 0.75rem; color: rgb(var(--gray-dark)); }
	.series-list span { color: var(--accent); font-size: 0.85rem; }
	.series-post-list li { border-bottom: 1px solid rgba(var(--black), 0.15); }
	.series-post-list a { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1rem 0; color: inherit; text-decoration: none; }
	.series-post-list h2 { font-size: 1.25rem; }
	.series-post-list p { margin: 0; color: rgb(var(--gray)); font-size: 0.9rem; }
	.series-post-list time { flex: 0 0 auto; color: rgb(var(--gray)); font-size: 0.8rem; }
	@media (max-width: 720px) { .series-post-list a { display: block; } }
</style>
