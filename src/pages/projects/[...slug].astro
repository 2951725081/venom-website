---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ProjectStatus from '../../components/projects/ProjectStatus.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, description, status, startDate, updatedDate, topics, summary, nextStep } =
	project.data;
const { Content } = await render(project);
// Normalize the base path (e.g. `/venom-website`) so links work with or
// without a trailing slash in `import.meta.env.BASE_URL`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectsHref = `${base}/projects/`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 960px;
			}
			article {
				max-width: 720px;
				margin: auto;
			}
			.project-header {
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgb(var(--gray));
			}
			.project-header h1 {
				margin: 0.5rem 0;
			}
			.project-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75em;
				margin-top: 0.75rem;
				color: rgb(var(--gray));
			}
			.project-topics {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin: 0.75rem 0 0;
				padding: 0;
				list-style-type: none;
			}
			.project-topics li {
				padding: 0.125em 0.5em;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				font-size: 0.85em;
			}
			.project-summary {
				font-style: italic;
				color: rgb(var(--gray-dark));
			}
			.next-step {
				margin-top: 1.5rem;
				padding: 1em;
				border-left: 4px solid rgb(var(--accent));
				background: rgb(var(--gray-light));
			}
			.back-link {
				display: inline-block;
				margin-top: 2rem;
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="project-header">
					<ProjectStatus status={status} />
					<h1>{title}</h1>
					<div class="project-meta">
						<span>
							Started <FormattedDate date={startDate} />
						</span>
						{updatedDate && (
							<span>
								Last updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					{topics.length > 0 && (
						<ul class="project-topics" aria-label="Topics">
							{topics.map((topic) => (
								<li>{topic}</li>
							))}
						</ul>
					)}
				</header>
				{summary && <p class="project-summary">{summary}</p>}
				<div class="project-body">
					<Content />
				</div>
				{nextStep && (
					<section class="next-step" aria-labelledby="next-step-heading">
						<h2 id="next-step-heading">Next step</h2>
						<p>{nextStep}</p>
					</section>
				)}
				<a class="back-link" href={projectsHref}>← Back to Projects</a>
			</article>
		</main>
		<Footer />
	</body>
</html>
