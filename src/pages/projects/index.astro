---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { PROJECT_STATUS_LABELS } from '../../components/projects/ProjectStatus.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf(),
);

const groups = (['organizing', 'archived', 'to-organize'] as const).map((status) => ({
	status,
	label: PROJECT_STATUS_LABELS[status],
	items: projects.filter((project) => project.data.status === status),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="Project archive with retrospectives and status tracking." />
		<style>
			main {
				width: 960px;
			}
			.projects-intro {
				max-width: 720px;
			}
			.status-group {
				margin-bottom: 2.5rem;
			}
			.status-group h2 {
				margin-bottom: 1rem;
				color: rgb(var(--black));
			}
			.status-group ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				margin: 0;
				padding: 0;
				list-style-type: none;
			}
			.status-group ul li {
				width: calc(50% - 0.75rem);
			}
			.status-empty {
				padding: 1em;
				border: 1px dashed rgb(var(--gray));
				border-radius: 8px;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.status-group ul {
					gap: 1rem;
				}
				.status-group ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="projects-intro">
				<h1>Projects</h1>
				<p>
					Project records with status, topics, and written retrospectives.
					Each entry documents background, decisions, failed attempts, and results.
				</p>
			</section>
			{
				groups.map((group) => (
					<section class="status-group" aria-labelledby={`group-${group.status}`}>
						<h2 id={`group-${group.status}`}>{group.label}</h2>
						{group.items.length > 0 ? (
							<ul>
								{group.items.map((project) => (
									<li>
										<ProjectCard project={project} />
									</li>
								))}
							</ul>
						) : (
							<p class="status-empty">No projects here yet.</p>
						)}
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
